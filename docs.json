{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "segmnt docs",
  "description": "segmnt is video infrastructure. Upload through one API and we encode, store, secure and stream it on your own domain. Use it for a course platform — or any product that needs video.",
  "logo": {
    "light": "/logo/segmnt-logo.svg",
    "dark": "/logo/segmnt-logo-dark.svg",
    "href": "https://segmnt.cloud"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#0B5D42",
    "light": "#6FC79E",
    "dark": "#0B5D42"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "IBM Plex Sans Arabic"
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart", "getting-started", "status"]
          },
          {
            "group": "Integrate",
            "pages": [
              "direct-upload",
              "manage-videos",
              "embed-a-video",
              "playback-tokens",
              "webhooks",
              "wordpress"
            ]
          },
          {
            "group": "Concepts",
            "pages": ["playback-protection", "glossary"]
          },
          {
            "group": "Account & billing",
            "pages": [
              "accounts-and-projects",
              "phone-verification",
              "usage-and-limits",
              "billing"
            ]
          },
          {
            "group": "Trust & safety",
            "pages": ["moderation", "reports-and-review"]
          },
          {
            "group": "Legal",
            "pages": ["legal"]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-overview", "errors", "changelog"]
          },
          {
            "group": "Endpoints",
            "openapi": {
              "source": "api/openapi.yaml",
              "overlays": ["api/public-overlay.yaml"]
            }
          }
        ]
      }
    ]
  }
}
