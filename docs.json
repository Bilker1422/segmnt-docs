{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "segmnt docs",
  "description": "Host and stream course videos with signed playback, up to 4K, billed in SAR. Guides for developers at agencies, course platforms and training companies.",
  "logo": {
    "light": "/logo/segmnt-logo.svg",
    "dark": "/logo/segmnt-logo-dark.svg",
    "href": "https://segmnt.cloud"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#0B5D42",
    "light": "#6FC79E",
    "dark": "#0B5D42"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "IBM Plex Sans Arabic"
  },
  "icons": {
    "library": "lucide"
  },
  "banner": {
    "content": "TEST environment. These docs run on TEST only. Production is a separate, board-approved step."
  },
  "seo": {
    "metatags": {
      "robots": "noindex"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Start here",
            "pages": ["index"]
          },
          {
            "group": "Guides",
            "pages": [
              "accounts-and-projects",
              "direct-upload",
              "phone-verification",
              "usage-and-limits",
              "billing",
              "reports-and-review",
              "moderation"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "api/openapi.yaml"
      }
    ]
  }
}
